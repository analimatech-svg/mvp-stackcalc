# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stackcalc
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/stackcalc

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Supabase (auth + storage) ───────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Security ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-min-32-chars-xxxxxxxxxxxxxxxx

# ─── LLM defaults (managed key / cloud mode) ─────────────────────────────────
LLM_MODE=byok           # byok | byom | onpremise
LLM_DEFAULT_PROVIDER=anthropic
LLM_DEFAULT_MODEL=claude-sonnet-4-6
LLM_DEFAULT_API_KEY=    # your Anthropic / OpenAI key

# On-premise / BYOM only:
# LLM_BASE_URL=http://ollama:11434/v1

# ─── Observability ───────────────────────────────────────────────────────────
HELICONE_API_KEY=

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
